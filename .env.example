# xdf-index summarize で Anthropic Messages API を呼ぶための API キー。
# 設定方法 (どれか1つ):
#   1. 本ファイルを `.env` にコピー → 値を埋める (リポジトリには push しない)
#   2. シェルに export ANTHROPIC_API_KEY=...
#   3. docker run -e ANTHROPIC_API_KEY=... ... で都度渡す
#
# キーは https://console.anthropic.com/ で発行。

ANTHROPIC_API_KEY=sk-ant-...

# (任意) アーカイブのソースディレクトリ。docker-compose の bind mount source。
# 省略時は ./tests/data
# 例: ARCHIVE_DIR=/mnt/nas/x68k
ARCHIVE_DIR=./tests/data

# (任意) HTTP モードで listen するホストポート (コンテナ側は固定 8765)
HTTP_PORT=8765

# (任意) Tailscale serve 等で公開する場合、rmcp の Host ヘッダ検証
# (DNS rebinding 防御) で許可するホスト名をカンマ区切りで指定。
# デフォルトの localhost / 127.0.0.1 / ::1 は常に許可される。
# 例: XDF_MCP_ALLOWED_HOSTS=myhost.your-tailnet.ts.net
XDF_MCP_ALLOWED_HOSTS=

# (任意) Bearer token 認証。Tailscale Funnel 等で公開インターネットに晒す場合に必須。
# 空なら認証なし。設定時はリクエストヘッダに `Authorization: Bearer <token>` が必要。
# トークン生成: openssl rand -hex 32
# 注意: Claude Desktop の Custom Connector は OAuth しか対応してないので、Bearer token
# 認証は curl 等の独自クライアント向け。Claude Desktop と組み合わせる場合は次の
# XDF_MCP_HTTP_PATH を使った URL 秘密路の方式を推奨。
XDF_MCP_AUTH_TOKEN=

# (任意) MCP エンドポイントのパス。デフォルト /mcp。
# Claude Desktop の Custom Connector で Bearer token の代替として「URL パス自体を
# 秘密にする」運用に使える (例: /<32char-hex>/mcp)。
# Anthropic 側に URL を登録するだけで認証相当の効果。漏洩したら全権限なので扱い注意。
# 生成: openssl rand -hex 16  → /<その値>/mcp の形にして指定。
XDF_MCP_HTTP_PATH=/mcp

# (任意) archive_extract が返す download_url の prefix。
# 公開 URL の host + 秘密パス を指定すると、Claude が返す download_url が
# `<PUBLIC_URL>/downloads/<uuid>.zip` の形になる。
# 例: XDF_MCP_PUBLIC_URL=https://myhost.your-tailnet.ts.net/<secret>
# 空のままだと output_path (コンテナ内パス) のみで取り回し可能。
XDF_MCP_PUBLIC_URL=
